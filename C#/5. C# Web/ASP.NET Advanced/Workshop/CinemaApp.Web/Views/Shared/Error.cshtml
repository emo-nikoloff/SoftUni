@model ErrorViewModel
@{
    ViewData["Title"] = $"{Model.StatusCode} - {Model.Title}";
}

<section class="error-page" aria-labelledby="error-title">
    <div class="error-page__glow error-page__glow--one"></div>
    <div class="error-page__glow error-page__glow--two"></div>

    <div class="error-page__content">
        <div class="error-page__icon" aria-hidden="true">
            <i class="bi @Model.Icon"></i>
        </div>
        <p class="error-page__code">@Model.StatusCode</p>
        <h1 id="error-title">@Model.Title</h1>
        <p class="error-page__message">@Model.Message</p>

        <div class="error-page__actions">
            <a class="btn btn-warning btn-lg" asp-controller="Home" asp-action="Index">
                <i class="bi bi-house-door me-2"></i>Back to home
            </a>
            <a class="btn btn-outline-light btn-lg" asp-controller="Movie" asp-action="Index">
                <i class="bi bi-camera-reels me-2"></i>Browse Movies
            </a>
        </div>

        @if (Model.ShowRequestId)
        {
            <p class="error-page__request">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }
    </div>
</section>
